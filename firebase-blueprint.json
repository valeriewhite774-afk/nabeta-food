{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with contact details, loyalty points and reward tiers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "loyaltyPoints": { "type": "number" },
        "phoneNumber": { "type": "string" },
        "addresses": { "type": "array" },
        "rewardTier": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Platinum"] }
      },
      "required": ["uid", "email", "displayName", "loyaltyPoints", "rewardTier"]
    },
    "Order": {
      "title": "Simulated Order",
      "description": "A customer meal order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "pointsUsed": { "type": "number" },
        "status": { "type": "string", "enum": ["placed", "preparing", "transit", "delivered"] },
        "timestamp": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] }
      },
      "required": ["id", "userId", "items", "subtotal", "deliveryFee", "total", "status", "timestamp", "deliveryAddress", "paymentMethod", "paymentStatus"]
    },
    "Notification": {
      "title": "App Notification",
      "description": "Push notification messages shown to the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string", "enum": ["order", "loyalty", "promo"] }
      },
      "required": ["id", "title", "message", "timestamp", "read", "type"]
    },
    "Review": {
      "title": "Gourmet Review",
      "description": "Premium customer food reviews for individual soups",
      "type": "object",
      "properties": {
        "menuItemId": { "type": "string" },
        "stars": { "type": "number" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["menuItemId", "stars", "text", "author", "location"]
    },
    "Setting": {
      "title": "Application Setting",
      "description": "Global application setting or configuration",
      "type": "object",
      "properties": {
        "paystackKey": { "type": "string" }
      },
      "required": ["paystackKey"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer profiles including loyalty points tracker"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Order records for real-time tracking"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific app alerts"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "General product reviews and evaluations"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global application configurations"
    }
  }
}
